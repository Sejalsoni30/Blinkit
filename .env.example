# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database (optional in dev; launches in-memory Mongo if omitted)
# MONGODB_URI=mongodb://localhost:27017/blinkit_dark_store
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/blinkit_db

# Security & JWT Tokens
JWT_SECRET=blinkit-dark-store-super-secret-jwt-key-2026
JWT_REFRESH_SECRET=blinkit-dark-store-refresh-secret-jwt-key-2026

# CORS Origin
CORS_ORIGIN=http://localhost:5173

# Python ML Microservice URL
ML_SERVICE_URL=http://localhost:8000
